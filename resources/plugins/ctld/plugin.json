{
    "nameInUI": "CTLD (Cargo Transport & Logistics Deployment)",
    "descriptionInUI": "Helicopter and transport logistics: sling-loading crates, deploying troops and vehicles, and JTAC autolasing for laser-guided strikes.",
    "defaultValue": true,
    "specificOptions": [
        {
            "nameInUI": "Use only Retribution's crates and troops",
            "mnemonic": "tailorctld",
            "defaultValue": true,
            "descriptionInUI": "Unticked, CTLD's own stock crates, vehicles and troop groups are offered as well."
        },
        {
            "nameInUI": "Create a logistics unit in each pickup zone",
            "mnemonic": "logisticunit",
            "defaultValue": true
        },
        {
            "nameInUI": "Mark pickup and drop-off zones with smoke",
            "mnemonic": "smoke",
            "defaultValue": true
        },
        {
            "nameInUI": "Automatically spawn crates for airlift",
            "mnemonic": "airliftcrates",
            "defaultValue": false
        },
        {
            "nameInUI": "Real sling-loading (instead of radio-menu loading)",
            "mnemonic": "slingload",
            "defaultValue": false
        },
        {
            "nameInUI": "JTAC autolases targets",
            "mnemonic": "autolase",
            "defaultValue": true
        },
        {
            "nameInUI": "JTAC marks targets with smoke",
            "mnemonic": "jtacsmoke",
            "defaultValue": true,
            "enabledWhen": "autolase"
        },
        {
            "nameInUI": "JTAC uses the FC3 laser code (1113)",
            "mnemonic": "fc3LaserCode",
            "defaultValue": false,
            "enabledWhen": "autolase"
        },
        {
            "nameInUI": "Debug output (testing only)",
            "mnemonic": "debug",
            "defaultValue": false
        }
    ],
    "scriptsWorkOrders": [
        {
            "file": "CTLD-i18n.lua",
            "mnemonic": "ctld-i18n"
        },
        {
            "file": "CTLD.lua",
            "mnemonic": "ctld-script"
        }
    ],
    "configurationWorkOrders": [
        {
            "file": "ctld-config.lua",
            "mnemonic": "ctld-config"
        }
    ]
}
