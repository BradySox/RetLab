{
    "nameInUI": "Mission-start briefing popup",
    "descriptionInUI": "Runs the 'Mission-start briefing popup' setting. When a pilot slots in, a card shows the campaign, mission, date, time, callsign, aircraft, task and field, then a second card gives the startup and taxi call. Display only.",
    "defaultValue": true,
    "skipUI": true,
    "specificOptions": [
        {
            "nameInUI": "Seconds each card stays on screen",
            "mnemonic": "durationS",
            "defaultValue": 12,
            "maximumValue": 60,
            "minimumValue": 3
        },
        {
            "nameInUI": "Delay after slot-in before the first card (seconds)",
            "mnemonic": "startDelayS",
            "defaultValue": 5,
            "minimumValue": 0,
            "maximumValue": 60
        },
        {
            "nameInUI": "Ground frequency on the taxi card",
            "mnemonic": "groundFreq",
            "defaultValue": "249.50"
        },
        {
            "nameInUI": "Beep as each card shows",
            "mnemonic": "playSound",
            "defaultValue": true
        }
    ],
    "scriptsWorkOrders": [],
    "configurationWorkOrders": [
        {
            "file": "briefing-config.lua",
            "mnemonic": "briefing-config"
        }
    ],
    "otherResourceFiles": [
        "briefing-beep.wav"
    ]
}
