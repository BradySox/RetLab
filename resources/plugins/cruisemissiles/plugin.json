{
    "nameInUI": "Cruise missile strikes",
    "descriptionInUI": "Runs the 'Ship-launched cruise missile strikes' setting: the planned raids, the F10 'Cruise Missile Strike' menu (a salvo onto your last map marker; type a number in the marker to set the count) and the campaign magazine. Each launch also puts the defender's air defense near the aimpoint on alert.",
    "defaultValue": true,
    "skipUI": true,
    "specificOptions": [
        {
            "nameInUI": "Auto raids: launch window opens (seconds after mission start)",
            "mnemonic": "raidDelayMinS",
            "defaultValue": 240,
            "minimumValue": 0,
            "maximumValue": 3600
        },
        {
            "nameInUI": "Auto raids: launch window closes (seconds after mission start)",
            "mnemonic": "raidDelayMaxS",
            "defaultValue": 900,
            "minimumValue": 0,
            "maximumValue": 3600
        },
        {
            "nameInUI": "Call-for-fire salvo size",
            "mnemonic": "playerSalvoSize",
            "defaultValue": 4,
            "minimumValue": 1,
            "maximumValue": 24,
            "descriptionInUI": "Used when the marker text has no number."
        },
        {
            "nameInUI": "Call-for-fire max ship-to-target range (NM)",
            "mnemonic": "playerRangeNm",
            "defaultValue": 250,
            "minimumValue": 10,
            "maximumValue": 1000
        },
        {
            "nameInUI": "Impact dispersion radius (ft)",
            "mnemonic": "salvoRadiusFt",
            "defaultValue": 330,
            "minimumValue": 0,
            "maximumValue": 3000
        },
        {
            "nameInUI": "F10 call-for-fire menu",
            "mnemonic": "menuEnabled",
            "defaultValue": true
        },
        {
            "nameInUI": "Wake the defender's air defense near the aimpoint",
            "mnemonic": "defenderWake",
            "defaultValue": true,
            "descriptionInUI": "Sets alarm state red for the missiles' flight time, since DCS never wakes a defender for a cruise missile."
        },
        {
            "nameInUI": "Wake radius around the aimpoint (NM)",
            "mnemonic": "defenderWakeRadiusNm",
            "defaultValue": 8,
            "enabledWhen": "defenderWake",
            "minimumValue": 1,
            "maximumValue": 50
        },
        {
            "nameInUI": "Hold the wake past the missiles' arrival (seconds)",
            "mnemonic": "defenderWakeExtraS",
            "defaultValue": 300,
            "enabledWhen": "defenderWake",
            "minimumValue": 0,
            "maximumValue": 1800
        }
    ],
    "scriptsWorkOrders": [],
    "configurationWorkOrders": [
        {
            "file": "cruisemissiles-config.lua",
            "mnemonic": "cruisemissiles-config"
        }
    ]
}
